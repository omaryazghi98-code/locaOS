{
  "name": "@locaos/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./i18n": { "types": "./dist/i18n.d.ts", "default": "./dist/i18n.js" },
    "./permissions": { "types": "./dist/permissions.d.ts", "default": "./dist/permissions.js" },
    "./labels": { "types": "./dist/labels.d.ts", "default": "./dist/labels.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "~5.7.3",
    "vitest": "^3.0.5"
  }
}
