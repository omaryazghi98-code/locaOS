# locaOS environment — copy to .env and adjust. NEVER commit real secrets.
NODE_ENV=development

# PostgreSQL (dev default: embedded postgres on 5432, started via `pnpm db:start`)
DATABASE_URL=postgresql://locaos:locaos@127.0.0.1:5432/locaos

# API
API_PORT=3001
SESSION_SECRET=change-me-generate-a-long-random-string
SESSION_TTL_DAYS=30
COOKIE_SECURE=false            # true behind HTTPS in production

# Storage (MVP: local filesystem adapter behind the StoragePort)
STORAGE_DIR=./data/storage

# PDF (headless Chromium via @sparticuz/chromium; override path for a system Chromium)
CHROMIUM_EXECUTABLE=

# Background evaluator (inlined worker for MVP)
ENABLE_SCHEDULER=true

# Seed (DEMO ONLY — seeder refuses in production unless SEED_ALLOW_PRODUCTION=true + explicit password)
SEED_PASSWORD=locaos-demo-2026
SEED_ALLOW_PRODUCTION=false
